  "notices": [
    {
      "id": "notice_1",
      "title": "Water Supply Maintenance - Bengaluru South Zone",
      "content": "There will be a temporary suspension of drinking water supply in JP Nagar Ward 12 on Saturday from 9:00 AM to 2:00 PM due to urgent main pipe repair work in Bengaluru South. All residents store sufficient water in advance.",
      "publishedAt": "2026-06-25T08:00:00Z",
      "expiryDate": "2026-06-29",
      "category": "Water",
      "targetZone": "Bengaluru South",
      "authorName": "Sunita Sharma (South Officer)"
    },
    {
      "id": "notice_2",
      "title": "Gram Sabha General Assembly Invitation",
      "content": "A General Gram Sabha assembly will be held at the Panchayath Community Hall on July 5, 2026, at 11:00 AM under the chairmanship of Sarpanch Rajesh Kumar Singh. All citizens across all zones are warmly invited to attend.",
      "publishedAt": "2026-06-24T09:00:00Z",
      "expiryDate": "2026-07-06",
      "category": "Administration",
      "targetZone": "All Areas",
      "authorName": "Rajesh Kumar Singh (Admin)"
    },
    {
      "id": "notice_3",
      "title": "Road Asphalt Repair Work - Bengaluru North Zone",
      "content": "Yelahanka main road junction will undergo heavy road asphalt resurfacing on Sunday. Commuters in Bengaluru North Zone are advised to use service lane bypasses.",
      "publishedAt": "2026-06-26T10:00:00Z",
      "expiryDate": "2026-07-02",
      "category": "Engineering",
      "targetZone": "Bengaluru North",
      "authorName": "Vijay Deshmukh (North Officer)"
    },
    {
      "id": "notice_4",
      "title": "Subsidized Seed Distribution - Bengaluru East Zone",
      "content": "Whitefield Agricultural Center is distributing high-yield organic hybrid seeds starting Friday. Registered farmers in Bengaluru East Zone can present their Krishi ID to claim seed packets.",
      "publishedAt": "2026-06-27T08:30:00Z",
      "expiryDate": "2026-07-10",
      "category": "Welfare",
      "targetZone": "Bengaluru East",
      "authorName": "Ananya Rao (East Officer)"
    },
    {
      "title": "Street Light Repair and Maintenance",
      "content": "All residents are hereby informed that maintenance and repair work for non-functional street lights will be carried out in the affected areas. Residents are requested to report faulty or damaged street lights through the Grievance section of the Smart Gram Panchayath Platform.",
      "publishedAt": "2026-09-10T11:20:49.091Z",
      "expiryDate": "2026-10-10",
      "category": "General",
      "fileUrl": "",
      "targetZone": "Bengaluru South",
      "targetArea": "Bengaluru South",
      "authorName": "Sunita Sharma (Bengaluru South Officer)",
      "id": "not_1789039249091_161"
    }
