# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: API Key for Google Maps Platform location picker
GOOGLE_MAPS_PLATFORM_KEY=

# SMTP Email Configuration (Optional for real email delivery in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Namma Panchayath <no-reply@gram.gov.in>"

# MongoDB Connection URI (Primary & Only Runtime Database)
MONGODB_URI="mongodb://127.0.0.1:27017/namma_panchayath"

