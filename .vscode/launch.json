{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Namma Panchayath",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run MongoDB Migration",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "migrate"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
